#!/bin/sh
# Two guards on a push to `main`, in order:
#
#   1. scripts/push-queue.mjs           — is it your TURN?
#   2. scripts/check-inflight-prod-build.mjs — may ANYONE push right now?
#
# The queue runs first on purpose: it is local and cheap, and it means only the
# head of the line ever spends a Vercel API call on the build check. The two
# answer different questions and neither replaces the other — the build guard
# stops a second build from being billed, the queue stops the retry scramble
# that guard creates from serving whoever polls luckiest instead of whoever
# waited longest.
#
# The reasoning, the measurements and the fail-open policy live in those two
# scripts. This file stays a thin shim on purpose: it is COPIED into the active
# hooks directory by `npm run hooks:install`, so a stale copy can survive there
# for a long time. Keeping the logic in the tracked scripts means the installed
# shim never needs to change, and the behaviour is always whatever the checkout
# says it is.
#
# ⚠ Every failure path here exits 0. A cost guard that can strand a deploy is
# worse than the cost it saves.

[ "$AF_SKIP_PREPUSH_HOOK" = "1" ] && exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
scripts="$root/scripts"

# 🛑 FALL BACK TO THE PRIMARY CHECKOUT, OR THIS GUARD IS DECORATIVE.
# This repo runs from many worktrees, and the sessions that push to `main` build
# their commit against origin/main with a temporary index -- which never updates
# the worktree. Those checkouts therefore sit on old commits indefinitely and do
# NOT contain these scripts, so a local-only lookup would silently no-op for
# exactly the sessions doing the pushing. That is the same invisible failure the
# guards exist to prevent. The shared hooks directory already belongs to the
# primary checkout, so borrowing its copy adds no new dependency.
# No glob-matching on the path: deciding "is this absolute?" with a case pattern
# has to handle POSIX roots, `F:/...` drive letters and backslashes at once, and
# the first version of this silently produced `C:/worktree/F:/primary/...` and
# resolved to nothing. `-d` answers the same question without a pattern.
if [ ! -f "$scripts/check-inflight-prod-build.mjs" ]; then
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=""
  [ -d "$common" ] || common=$(git rev-parse --git-common-dir 2>/dev/null) || common=""
  [ -d "$common" ] || exit 0
  scripts="$(dirname "$common")/scripts"
fi

command -v node >/dev/null 2>&1 || exit 0

# 🛑 STDIN IS READ ONCE, HERE. Git feeds the pre-push payload
# (`<localRef> <localSha> <remoteRef> <remoteSha>`) on stdin, and it can only be
# consumed once -- the previous version could `exec` because it had a single
# guard. With two, the first would swallow the payload and the second would see
# an empty stdin, conclude "not a push to main" and wave everything through. It
# would have looked like a working guard forever.
payload=$(cat)

# The status of `printf | node` IS node's -- a pipeline reports its LAST command,
# and node is last. That is the intended reading here, not the trap CLAUDE.md
# describes (which is reading the status of a command that is NOT last).
run_guard() {
  script="$1"
  shift
  [ -f "$script" ] || return 0
  printf '%s\n' "$payload" | node "$script" "$@"
}

run_guard "$scripts/push-queue.mjs" check || exit 1
run_guard "$scripts/check-inflight-prod-build.mjs" || exit 1

exit 0
