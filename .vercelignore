# Build artifacts and caches
.next
.next-*
node_modules

# Tooling and editor state
.git
.github
.vscode
.claude
.cursor
.agents
.vercel

# Test and report outputs
playwright-report
test-results
e2e/__snapshots__

# Temporary/debug files
.tmp
tmp-*
*.tmp
*.log
*.txt

# ...but data/ holds runtime fs-read files, and the blanket *.txt above would
# strip committed .txt data from the deployment while dev keeps working.
!data/**/*.txt

# Optional non-runtime docs/assets
artifacts
design-refs
_design-refs
/drafts
docs
