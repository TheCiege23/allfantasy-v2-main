    "sections": [
      {
        "topic": "overview",
        "title": "How the season works",
        "lines": [
          "Two tribes compete every week; your fantasy points add to your tribe total.",
          "The lower-scoring tribe goes to Tribal Council and votes someone out.",
          "Voted-out managers go to Exile Island and can earn their way back."
        ]
      },
      {
        "topic": "immunity",
        "title": "Immunity",
        "lines": [
          "The higher-scoring tribe is safe for the week.",
          "Winning a tribe challenge can also grant immunity."
        ]
      },
      {
        "topic": "voting",
        "title": "Voting at Tribal Council",
        "lines": [
          "Every manager at council casts one secret vote before Mon 8:00 PM.",
          "You cannot vote for yourself.",
          "A missed vote counts for nothing; it does not count against you."
        ]
      },
      {
        "topic": "idols",
        "title": "Hidden immunity idols",
        "lines": [
          "An idol cancels every vote cast against you at one Tribal Council.",
          "Play it before votes close. Nobody else is told you hold one."
        ]
      }
    ]
