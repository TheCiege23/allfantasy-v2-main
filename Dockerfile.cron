# The `allfantasy-cron` Railway service: runs the app's crons off GitHub's runner pool.
# See scripts/cron-scheduler.mjs for why, and for the dry-run / live switch.
#
# Named Dockerfile.cron, never Dockerfile: a root `Dockerfile` would switch the web and worker
# services off Railpack on their next deploy. Only this service points at it
# (RAILWAY_DOCKERFILE_PATH=Dockerfile.cron).
#
# No `npm install`: the four scripts import only node: built-ins and each other
# (__tests__/scripts/cron-scheduler.test.ts asserts that, and that every file below exists).
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY cron-schedule.json ./
COPY scripts/cron-scheduler.mjs scripts/cron-fast-tier-loop.mjs scripts/cron-tier.mjs scripts/cron-dispatch.mjs scripts/cron-build-reaper.mjs ./scripts/
# The fast loop reads each route's `maxDuration` to size its request timeout. Without these the
# 300s routes silently fall back to a default timeout and read as failures. The test asserts every
# fast-tier route lives under one of these directories.
COPY app/api/cron ./app/api/cron
COPY app/api/redraft ./app/api/redraft

USER node
CMD ["node", "scripts/cron-scheduler.mjs"]
