# Player value reference docs now live in data/player-values/ and are deliberately
# NOT ignored: they are read with fs at runtime, so they must be committed to reach
# production. Ignoring them is why this grounding never loaded on Vercel.
# See data/player-values/README.md.

# Local scratch logs from build/test/dev runs that occasionally land in the
# repo root and pollute `git status`. None of these are product files; the
# real outputs go through stdout/stderr and the harness `tasks/` folder.
build-latest.txt
build-nolint.out
build-output-clean.txt
build-test.txt
build-wrapper-latest.txt
chimmy-gate-latest.txt
draft-vitest-run.txt
test-out.txt
test-summary.txt
spotify-test-results.txt
spotify-test-results-*.txt
spotify-final-results.txt
.tmp/

# Local build and background-task locks; regenerated per session.
.next-build.lock
.claude/scheduled_tasks.lock
.env*.local

.env.redraft-test
.env*
