# Next / node
node_modules/
.next/
# Ad-hoc verification build dirs (.next-myteam-3100, .next-verify-nocturne, …) are
# created routinely by local dev/verification runs and reach hundreds of MB each.
# Without this they show up as untracked and are one `git add -A` away from the repo.
.next-*/
.next-playwright-*/
.next-dev*/
.next-dev-local/
.next-dev-local-uifix/
out/
dist/
build/
.pnp
.pnp.js

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
.env.local
.env.*.local

# archives
*.zip
project.zip

# common large assets
attached_assets/
uploads/
tmp/
.cache/

# misc
.DS_Store
*.pem

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.tsc-errors*.txt
.tsc-out.txt

# prisma
prisma/*.db
prisma/*.db-journal

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# local RI probe (do not commit)
scripts/ri-import-all.ts

# local agent settings (may contain secrets)
.claude/settings.local.json

# Pre-write snapshots taken by the destructive maintenance scripts. These are verbatim dumps
# of PRODUCTION rows, and this repo is public — they must never be committed. The dedupe
# script has been writing to this path since before the rule existed.
scripts/.dedupe-players-snapshot-*.json
scripts/.orphan-player-images-snapshot-*.json
# Holds prior password hashes for the fixture accounts being rotated — never commit.
scripts/.fixture-accounts-snapshot-*.json
# Full row dumps of the fixture users/leagues/players deleted by cleanup-fixture-data.
scripts/.fixture-data-snapshot-*.json

# Player value reference docs (local updates; folder tracked via .gitkeep)
app/player-values/*.md
app/player-values/*.txt
app/player-values/*.csv
app/player-values/*.json
!app/player-values/.gitkeep

# Local scratch logs from build/test/dev runs that occasionally land in the
# repo root and pollute `git status`. None of these are product files; the
# real outputs go through stdout/stderr and the harness `tasks/` folder.
build-latest.txt
build-nolint.out
build-output-clean.txt
build-test.txt
build-wrapper-latest.txt
chimmy-gate-latest.txt
draft-vitest-run.txt
test-out.txt
test-summary.txt
spotify-test-results.txt
spotify-test-results-*.txt
spotify-final-results.txt
.tmp/

# Local build and background-task locks; regenerated per session.
.next-build.lock
.claude/scheduled_tasks.lock
.env*.local

.env.redraft-test
.env*

# dedupe snapshots contain production row dumps — never commit them
scripts/.dedupe-players-snapshot-*.json
