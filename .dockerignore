# Keep the build context to source. Several .next-* directories are committed in
# this repo, and copying them into the image would both bloat it and put stale
# build output next to the one the build is about to produce.
.git
.github
node_modules
.next
.next-*
!.next-*/types

# Local env files. Railway supplies configuration as service variables; copying
# these in would shadow them and risk baking local credentials into the image.
.env
.env.*
!.env.production
!.env.example

# Test, tooling and scratch output that the production build never reads.
__tests__
e2e
tests
playwright-report
test-results
coverage
.claude
.cursor
.agents
*.log
